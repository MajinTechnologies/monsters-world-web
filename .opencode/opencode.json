{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "kairos-worker",
  "instructions": [".opencode/docs/ci-chain.md"],
  "plugin": [
    "./plugin/resolver-vars.ts"
  ],
  "permission": {
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "question": "allow",
    "websearch": "allow",
    "webfetch": "allow",
    "todowrite": "allow",
    "edit": "ask",
    "bash": "ask"
  },
  "agent": {
    "kairos-worker": {
      "mode": "primary",
      "description": "Worker de CI de Kairos: sesiones atomicas encadenadas sobre issues con label kairos:ci (protocolo ci-chain).",
      "prompt": "{file:prompts/kairos-worker.md}",
      "permission": {
        "edit": {
          "*": "ask",
          "*.md": "allow"
        },
        "bash": {
          "*": "ask",
          "git *": "allow",
          "gh *": "allow",
          "npm *": "allow",
          "npx *": "allow",
          "node *": "allow",
          "curl *": "allow",
          "jq *": "allow",
          "python3 *": "allow",
          "ls *": "allow",
          "cat *": "allow",
          "head *": "allow",
          "tail *": "allow",
          "grep *": "allow",
          "find *": "allow",
          "mkdir *": "allow",
          "cp *": "allow",
          "mv *": "allow",
          "rm *": "allow",
          "pwd *": "allow",
          "echo *": "allow",
          "test *": "allow",
          "diff *": "allow",
          "wc *": "allow",
          "sudo *": "deny"
        },
        "task": "allow"
      }
    }
  },
  "command": {},
  "lsp": false,
  "mcp": {
    "circino": {
      "type": "local",
      "command": [
        "node",
        "{env:CIRCINO_MCP_SERVER}"
      ],
      "environment": {
        "GITHUB_TOKEN": "{env:GITHUB_TOKEN}",
        "MAJIN_AGENT": "Kairos-CI",
        "MAJIN_USER": "{env:MAJIN_GH_USER}",
        "MAJIN_GH_USER": "{env:MAJIN_GH_USER}",
        "MAJIN_OPERATOR_NAME": "{env:MAJIN_OPERATOR_NAME}",
        "MAJIN_OWNER": "{env:MAJIN_OWNER}",
        "MAJIN_REPO": "{env:MAJIN_REPO}"
      }
    },
    "github": {
      "type": "local",
      "command": [
        "node",
        "{env:GITHUB_MCP_SERVER}"
      ],
      "environment": {
        "GITHUB_TOKEN": "{env:GITHUB_TOKEN}"
      }
    }
  }
}
